{
  "name": "guia-runeterra-studio-motores",
  "version": "0.1.0",
  "private": true,
  "description": "Motor de vídeo COMPARTILHADO entre os canais (Remotion, React, three.js). Uma só node_modules, aqui na raiz; as pastas dos canais só têm código e resolvem os pacotes subindo até aqui.",
  "scripts": {
    "estudio:f1-vertical": "remotion studio F1/vertical/video/src/index.ts",
    "estudio:f1-horizontal-v1": "remotion studio F1/horizontal/v1/src/index.ts",
    "estudio:f1-horizontal": "remotion studio F1/horizontal/remotion/src/index.ts",
    "tipos:f1-vertical": "tsc --noEmit -p F1/vertical/video",
    "tipos:f1-horizontal-v1": "tsc --noEmit -p F1/horizontal/v1",
    "tipos:f1-horizontal": "tsc --noEmit -p F1/horizontal/remotion",
    "tipos:runeterra": "tsc --noEmit -p app/video"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/gif": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/three": "0.169.0",
    "typescript": "5.9.3"
  }
}
