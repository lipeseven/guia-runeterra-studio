{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "f1-horizontal/historia.schema.json",
  "title": "História (estrutura documental) de um vídeo horizontal",
  "type": "object",
  "required": ["versao", "titulo", "tese", "roteiro_hash", "tempos", "capitulos", "afirmacoes"],
  "additionalProperties": false,
  "properties": {
    "versao": {"const": 1},
    "titulo": {"type": "string", "minLength": 3},
    "tese": {"type": "string", "minLength": 3, "description": "a resposta/ideia central que o vídeo prova"},
    "roteiro_hash": {"type": "string", "pattern": "^[0-9a-f]{12}$"},
    "tempos": {"enum": ["medidos", "estimados"]},
    "capitulos": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capitulo"}},
    "afirmacoes": {"type": "array", "items": {"$ref": "#/$defs/afirmacao"}},
    "fontes": {"type": "array", "items": {"type": "string"}},
    "criado_em": {"type": "string"},
    "avisos": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "capitulo": {
      "type": "object",
      "required": ["id", "titulo", "funcao", "ritmo", "em", "i"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^c[0-9]+$"},
        "titulo": {"type": "string", "minLength": 2},
        "funcao": {"enum": ["gancho", "contexto", "evidencia", "tensao", "virada", "desfecho"]},
        "ritmo": {"enum": ["denso", "respiro"]},
        "em": {"type": "string", "minLength": 1, "description": "trecho LITERAL do roteiro onde o capítulo começa"},
        "i": {"type": "integer", "minimum": 0},
        "i1": {"type": "integer", "minimum": 0}
      }
    },
    "carro": {
      "type": "object",
      "required": ["piloto", "volta"],
      "additionalProperties": false,
      "properties": {
        "piloto": {"type": "integer", "minimum": 1, "maximum": 99, "description": "número do carro (OpenF1 driver_number)"},
        "volta": {"anyOf": [{"type": "integer", "minimum": 1}, {"const": "melhor"}]}
      }
    },
    "afirmacao": {
      "type": "object",
      "required": ["id", "texto", "em", "i", "tipo", "verificavel", "capitulo"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^a[0-9]+$"},
        "texto": {"type": "string", "minLength": 3},
        "em": {"type": "string", "minLength": 1},
        "i": {"type": "integer", "minimum": 0},
        "capitulo": {"type": "string", "pattern": "^c[0-9]+$"},
        "tipo": {"enum": ["tempo_volta", "diferenca", "setor", "velocidade", "evento", "posicao", "estrategia", "contexto"]},
        "verificavel": {"type": "boolean"},
        "sessao": {"type": "integer", "minimum": 1, "description": "OpenF1 session_key"},
        "carros": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/carro"}},
        "setor": {"type": "integer", "minimum": 1},
        "evento": {"type": "string"},
        "valor": {"type": "number"},
        "unidade": {"enum": ["s", "km/h", "m", "%", "posicao", "voltas"]},
        "fonte": {"type": "string"}
      },
      "anyOf": [
        {"properties": {"verificavel": {"const": false}}},
        {"properties": {"verificavel": {"const": true}}, "required": ["sessao", "carros", "fonte"]}
      ]
    }
  }
}
