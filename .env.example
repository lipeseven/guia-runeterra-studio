# Copie este arquivo para ".env" (na mesma pasta) e preencha os valores.
# O ".env" fica só no seu PC: está no .gitignore e nunca vai para o GitHub.

# Fish Audio — voz guia (modelo s2.1-pro-free). Chave em https://fish.audio (painel de API).
FISH_API_KEY=

# Freesound — efeitos sonoros. https://freesound.org/apiv2/apply
FREESOUND_CLIENT_ID=
FREESOUND_API_KEY=

# Hugging Face — baixar o Stable Audio Open (aceite os termos na página do modelo). https://huggingface.co/settings/tokens
HF_TOKEN=
